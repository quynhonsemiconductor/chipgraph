{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A reference to an artifact, identifying it without describing its content.",
      "properties": {
        "kind": {
          "description": "The kind of artifact this is, e.g. rtl, spec, report.",
          "enum": [
            "spec",
            "rtl",
            "tb",
            "sva",
            "report",
            "plan",
            "model",
            "doc",
            "diagram",
            "script",
            "config",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "internal",
          "description": "Data sensitivity label: public, internal, or nda.",
          "enum": [
            "public",
            "internal",
            "nda"
          ],
          "title": "Label",
          "type": "string"
        },
        "model_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key into the Design Model when this artifact is model-based, not a file.",
          "title": "Model Key"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "POSIX path to the artifact, relative to the repo root, when it is file-based.",
          "title": "Path"
        },
        "repo": {
          "default": ".",
          "description": "The workspace member (repo) id this artifact belongs to.",
          "title": "Repo",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Schema version of this model.",
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The specification of a gate: which artifacts need human approval, and how.",
  "properties": {
    "approvers": {
      "default": [],
      "description": "Identities allowed to approve this gate.",
      "items": {
        "type": "string"
      },
      "title": "Approvers",
      "type": "array"
    },
    "artifacts": {
      "description": "The artifacts this gate covers.",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "id": {
      "description": "The id of this gate.",
      "title": "Id",
      "type": "string"
    },
    "mode": {
      "default": "file",
      "description": "How approval is recorded.",
      "enum": [
        "pr",
        "file"
      ],
      "title": "Mode",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Schema version of this model.",
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "artifacts"
  ],
  "title": "GateSpec",
  "type": "object"
}
