{
  "$defs": {
    "EarsParts": {
      "additionalProperties": false,
      "description": "A requirement's text, broken into EARS-style structured parts (DESIGN.md 8/M3-08).\n\nOptional: an extractor that only has the raw sentence leaves these unset.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The required behavior ('shall ...').",
          "title": "Action"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A qualifying state ('while ...').",
          "title": "Condition"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The system or object the REQ is about.",
          "title": "Subject"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The triggering event ('when ...').",
          "title": "Trigger"
        }
      },
      "title": "EarsParts",
      "type": "object"
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Records where a single entity or relation fact was learned from.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Content hash of the source artifact, if known.",
          "title": "Artifact"
        },
        "extractor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The extractor or format adapter id that produced this fact.",
          "title": "Extractor"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "POSIX path the fact was read from, relative to the repo root.",
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The 1-based line number, if any.",
          "title": "Line"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Schema version of this model.",
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A single requirement, usually with a REQ-ID.",
  "properties": {
    "attrs": {
      "additionalProperties": {
        "$ref": "#/$defs/JSONValue"
      },
      "description": "Open-ended extra facts not covered by typed fields.",
      "title": "Attrs",
      "type": "object"
    },
    "ears": {
      "anyOf": [
        {
          "$ref": "#/$defs/EarsParts"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Structured EARS parts, when available."
    },
    "key": {
      "description": "The stable model key, e.g. 'register:timer.CTRL'.",
      "title": "Key",
      "type": "string"
    },
    "kind": {
      "const": "requirement",
      "default": "requirement",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "description": "A short human-readable name for this entity.",
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Schema version of this model.",
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/Provenance",
      "description": "Where this fact was learned from."
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The requirement's full sentence.",
      "title": "Text"
    }
  },
  "required": [
    "key",
    "name"
  ],
  "title": "RequirementEntity",
  "type": "object"
}
