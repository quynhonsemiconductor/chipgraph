{
  "$defs": {
    "JSONValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Records where a single entity or relation fact was learned from.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Content hash of the source artifact, if known.",
          "title": "Artifact"
        },
        "extractor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The extractor or format adapter id that produced this fact.",
          "title": "Extractor"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "POSIX path the fact was read from, relative to the repo root.",
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The 1-based line number, if any.",
          "title": "Line"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Schema version of this model.",
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A port on a module.",
  "properties": {
    "attrs": {
      "additionalProperties": {
        "$ref": "#/$defs/JSONValue"
      },
      "description": "Open-ended extra facts not covered by typed fields.",
      "title": "Attrs",
      "type": "object"
    },
    "clock": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model key of the clock this port is in.",
      "title": "Clock"
    },
    "direction": {
      "anyOf": [
        {
          "enum": [
            "input",
            "output",
            "inout"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Port direction.",
      "title": "Direction"
    },
    "key": {
      "description": "The stable model key, e.g. 'register:timer.CTRL'.",
      "title": "Key",
      "type": "string"
    },
    "kind": {
      "const": "port",
      "default": "port",
      "title": "Kind",
      "type": "string"
    },
    "module": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model key of the owning module.",
      "title": "Module"
    },
    "name": {
      "description": "A short human-readable name for this entity.",
      "title": "Name",
      "type": "string"
    },
    "reset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model key of the reset this port uses.",
      "title": "Reset"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Schema version of this model.",
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/Provenance",
      "description": "Where this fact was learned from."
    },
    "width": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Port width: an int, or an unresolved expression string.",
      "title": "Width"
    }
  },
  "required": [
    "key",
    "name"
  ],
  "title": "PortEntity",
  "type": "object"
}
