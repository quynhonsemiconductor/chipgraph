{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A reference to an artifact, identifying it without describing its content.",
      "properties": {
        "kind": {
          "description": "The kind of artifact this is, e.g. rtl, spec, report.",
          "enum": [
            "spec",
            "rtl",
            "tb",
            "sva",
            "report",
            "plan",
            "model",
            "doc",
            "diagram",
            "script",
            "config",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "internal",
          "description": "Data sensitivity label: public, internal, or nda.",
          "enum": [
            "public",
            "internal",
            "nda"
          ],
          "title": "Label",
          "type": "string"
        },
        "model_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key into the Design Model when this artifact is model-based, not a file.",
          "title": "Model Key"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "POSIX path to the artifact, relative to the repo root, when it is file-based.",
          "title": "Path"
        },
        "repo": {
          "default": ".",
          "description": "The workspace member (repo) id this artifact belongs to.",
          "title": "Repo",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Schema version of this model.",
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A rule bound to concrete parameters, with resolved inputs and outputs.",
  "properties": {
    "inputs": {
      "default": [],
      "description": "Resolved input artifact references.",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Inputs",
      "type": "array"
    },
    "instance_id": {
      "description": "A stable id for this instance, built by make_id().",
      "title": "Instance Id",
      "type": "string"
    },
    "outputs": {
      "description": "Resolved output artifact references.",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Outputs",
      "type": "array"
    },
    "params": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Concrete parameter values, e.g. block, module.",
      "title": "Params",
      "type": "object"
    },
    "rule_id": {
      "description": "The id of the rule this is an instance of.",
      "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_]*$",
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Schema version of this model.",
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "rule_id",
    "outputs",
    "instance_id"
  ],
  "title": "RuleInstance",
  "type": "object"
}
